int mult(int a, int b) {
    return a * b;
}


int test(char a, int b, char c, int d, char e, int f, char g) {
    return mult(mult(a + b, c) - mult(d / b, -(e % a)), f) + g;

}


int temp(int a) {
    return a;
}


