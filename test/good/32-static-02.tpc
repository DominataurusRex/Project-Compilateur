/*
    static value
*/


void mount_pajamaja(void) {
    static int x_factor;
    putint(x_factor);
    x_factor = x_factor + 1;
}


void zeekeeper(void) {
    static int x_factor;
    putint(x_factor);
    x_factor = x_factor + 1;
}


int main(void) {
    int popple;
    popple = 0;
    while (popple < 10) {
        mount_pajamaja();
        zeekeeper();
        popple = popple + 1;
    }
    return 0;
}
